---
interface Props {
  eyebrow: string;
  title: string;
  emphasis?: string;
  lede: string;
  bgImage: string;
  bgAlt: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  compact?: boolean;
}
const {
  eyebrow,
  title,
  emphasis,
  lede,
  bgImage,
  bgAlt,
  primaryLabel = "Gratis werfbezoek aanvragen",
  primaryHref = "/contact/",
  secondaryLabel,
  secondaryHref,
  compact = false,
} = Astro.props;
---
<section class={compact ? "hero hero-compact" : "hero"}>
  <div class="hero-bg" role="img" aria-label={bgAlt} style={`background-image:linear-gradient(0deg, rgba(27,34,29,0.85) 0%, rgba(27,34,29,0.5) 45%, rgba(27,34,29,0.22) 100%), url(${bgImage})`}></div>
  <div class="wrap hero-inner">
    <p class="eyebrow" style="color:#D8DACC">{eyebrow}</p>
    <h1>{title}{emphasis && <> <em>{emphasis}</em></>}</h1>
    <p class="hero-lede">{lede}</p>
    <div class="hero-actions">
      <a class="btn on-photo" href={primaryHref}>{primaryLabel}</a>
      {secondaryLabel && secondaryHref && (
        <a class="btn on-photo ghost" href={secondaryHref}>{secondaryLabel}</a>
      )}
    </div>
    <div class="hero-loc">
      <svg class="pin" aria-hidden="true" viewBox="0 0 16 16" width="13" height="13" fill="none">
        <path d="M8 15C8 15 13 10.2 13 6.4C13 3.4 10.76 1 8 1C5.24 1 3 3.4 3 6.4C3 10.2 8 15 8 15Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
        <circle cx="8" cy="6.3" r="1.8" fill="currentColor"/>
      </svg>
      Gevestigd in Hasselt, actief in <b>heel Limburg</b>
    </div>
  </div>
</section>
