---
import { services, site } from "../data/site";
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <p class="foot-label foot-brand"><img src="/images/logo-mark-transparent.png" alt="" width="18" height="18" />{site.name}</p>
        <p>{site.tagline}<br />{site.address.addressLocality}<br />Haspengouw, België</p>
      </div>
      <div>
        <p class="foot-label">Diensten</p>
        <ul>
          {services.map((s) => (
            <li><a href={`/${s.slug}/`}>{s.navLabel}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="foot-label">Bedrijf</p>
        <ul>
          <li><a href="/over-ons/">Over ons</a></li>
          <li><a href="/realisaties/">Realisaties</a></li>
          <li><a href="/werkgebied-haspengouw/">Werkgebied</a></li>
          <li><a href="/veelgestelde-vragen/">Veelgestelde vragen</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/vacatures/">Vacatures</a></li>
        </ul>
      </div>
      <div>
        <p class="foot-label">Contact</p>
        <ul>
          <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{site.address.postalCode} {site.address.addressLocality}</li>
        </ul>
        <div class="social-links">
          <a href={site.social.whatsapp} target="_blank" rel="noopener" aria-label="Mani Verdi op WhatsApp">
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <circle cx="16" cy="16" r="16" fill="#25D366"/>
              <path fill="#fff" d="M16 7.4c-4.9 0-8.9 4-8.9 8.9 0 1.6.4 3.1 1.2 4.5L7 24.6l4-1.3c1.3.7 2.8 1.1 4.4 1.1 4.9 0 8.9-4 8.9-8.9s-3.4-8.1-8.3-8.1Zm5.2 12.6c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.6-1.1-4.3-3.8-4.5-4-.1-.2-1.1-1.4-1.1-2.7 0-1.3.7-1.9.9-2.1.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.8.8 1.9.1.2.1.3 0 .5-.1.2-.1.3-.3.5-.1.2-.3.4-.4.5-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.2 2.4 1.5 2.7 1.7.3.2.5.1.6-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.2.1 1.5.7 1.8.8.3.1.5.2.5.3.1.2.1.6-.1 1.2Z"/>
            </svg>
          </a>
          <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Mani Verdi op Facebook">
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <circle cx="16" cy="16" r="16" fill="#1877F2"/>
              <path fill="#fff" d="M18 11.5h2.2V8h-2.2c-2.6 0-4.2 1.7-4.2 4.2v1.9h-2.4v3.4h2.4V24h3.4v-6.5h2.4l.5-3.4h-2.9v-1.5c0-.7.4-1.1 1.1-1.1Z"/>
            </svg>
          </a>
          <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Mani Verdi op Instagram">
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <defs>
                <linearGradient id="ig-grad" x1="0" y1="32" x2="32" y2="0">
                  <stop offset="0" stop-color="#FFDD55"/>
                  <stop offset="0.5" stop-color="#E1306C"/>
                  <stop offset="1" stop-color="#5851DB"/>
                </linearGradient>
              </defs>
              <rect width="32" height="32" rx="9" fill="url(#ig-grad)"/>
              <rect x="9" y="9" width="14" height="14" rx="4.5" stroke="#fff" stroke-width="1.6" fill="none"/>
              <circle cx="16" cy="16" r="3.6" stroke="#fff" stroke-width="1.6" fill="none"/>
              <circle cx="20.6" cy="11.4" r="1" fill="#fff"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {year} {site.name} {site.legalForm}, {site.tagline}</span>
      <span>Ondernemingsnummer {site.companyNumber}</span>
      <span><a href="/privacyverklaring/">Privacyverklaring</a></span>
      <span>Website door <a href={site.builtBy.url} target="_blank" rel="noopener">{site.builtBy.name}</a></span>
    </div>
  </div>
</footer>
