---
interface Props {
  items: { name: string; path: string }[];
}
const { items } = Astro.props;
---
<nav class="breadcrumbs wrap" aria-label="Broodkruimel">
  <ol>
    {items.map((item, i) => (
      <li>{i === items.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.path}>{item.name}</a>}</li>
    ))}
  </ol>
</nav>
