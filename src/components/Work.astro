---
const items = [
  { img: "/images/tuinontwerp.jpg", w: 1920, h: 1080, alt: "3D-tuinontwerp met houten pergola en loungehoek", tag: "Ontwerpen" },
  { img: "/images/tuinaanleg.jpg", w: 1200, h: 1600, alt: "Afgewerkt totaalproject met grindoprit", tag: "Totaalprojecten" },
  { img: "/images/hagen.jpg", w: 526, h: 512, alt: "Strak gesnoeide buxushagen na onderhoud", tag: "Onderhoud" },
  { img: "/images/grondwerken.jpg", w: 526, h: 512, alt: "Grond- en afbraakwerken in uitvoering", tag: "Grond & afbraak" },
  { img: "/images/riolering.jpg", w: 526, h: 512, alt: "Graafwerk voor een rioleringsleiding in een tuin", tag: "Riolering" },
];
---
<section class="work" id="realisaties">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Onze realisaties</p>
        <h2>Laat u inspireren.</h2>
      </div>
      <p>Bekijk onze realisaties en droom alvast van uw eigen stukje paradijs.</p>
    </div>
    <div class="work-grid">
      {items.map((it) => (
        <div class="work-item">
          <img src={it.img} width={it.w} height={it.h} alt={it.alt} loading="lazy" />
          <span class="tag">{it.tag}</span>
        </div>
      ))}
    </div>
    <p style="margin-top:24px"><a class="btn ghost" href="/realisaties/">Alle realisaties bekijken</a></p>
  </div>
</section>
