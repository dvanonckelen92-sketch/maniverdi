---
import { services } from "../data/site";
---
<section class="intro">
  <div class="wrap intro-grid">
    <h2>Onze diensten in heel Limburg</h2>
    <div class="intro-body">
      <p>Mani Verdi ontwerpt, legt aan en onderhoudt tuinen. We gebruiken eigen machines en materialen die tegen zon, vorst en dagelijks gebruik kunnen.</p>
      <p>U hoeft niet alles bij ons te laten doen. Alleen een ontwerp, enkel de aanleg of alleen het onderhoud nadien kan ook.</p>
    </div>
  </div>
</section>

<section class="services" id="diensten">
  <div class="wrap service-grid">
    {services.map((s) => (
      <a class="service-card" href={`/${s.slug}/`}>
        <img src={s.image} width={s.imageW} height={s.imageH} alt={s.imageAlt} loading="lazy" />
        <div class="service-card-text">
          <h3>{s.navLabel}</h3>
          <p>{s.heroLede.slice(0, 70)}…</p>
        </div>
      </a>
    ))}
  </div>
</section>
