---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Footer from "../../../components/Footer.astro";
import { site } from "../../../data/site";

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Contact", path: "/contact/" },
  { name: "Bedankt", path: "/contact/bedankt/" },
];
---
<Layout
  title="Bedankt voor uw aanvraag | Mani Verdi"
  description="Uw offerteaanvraag bij Mani Verdi is verzonden. We nemen zo snel mogelijk contact met u op."
  path="/contact/bedankt/"
  breadcrumbs={breadcrumbs}
  noindex
>
  <Header />
  <main id="top">
    <div style="height:24px"></div>
    <Breadcrumbs items={breadcrumbs} />
    <section class="page-content">
      <div class="wrap">
        <h1 style="font-size:clamp(28px,4vw,40px);margin-bottom:16px">Bedankt voor uw aanvraag</h1>
        <p>
          Uw offerteaanvraag is goed ontvangen. Mani Verdi neemt binnen de paar werkdagen contact met u op om een
          gratis werfbezoek in te plannen. Heeft u ondertussen een vraag, bel dan gerust naar
          {" "}<a href={`tel:${site.phoneHref}`}>{site.phone}</a> of mail naar <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
        <p><a class="btn" href="/">Terug naar de homepage</a></p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
