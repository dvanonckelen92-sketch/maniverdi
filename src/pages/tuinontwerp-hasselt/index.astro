---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RelatedServices from "../../components/RelatedServices.astro";
import Faq from "../../components/Faq.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";
import { services } from "../../data/site";
import { faqSchema } from "../../data/schema";

const service = services.find((s) => s.slug === "tuinontwerp-hasselt")!;
const faqItems = [
  {
    q: "Wat kost een tuinontwerp in Hasselt?",
    a: "Een tuinontwerp op maat wordt meestal verrekend in de totale offerte voor de aanleg. Bij een gratis werfbezoek bespreekt Mani Verdi of een apart ontwerptraject nodig is of dat schets en aanleg in één stap kunnen.",
  },
  {
    q: "Hoe lang duurt het om een tuinontwerp te maken?",
    a: "Voor een gemiddelde particuliere tuin in Hasselt neemt het opmaken van een tuinplan doorgaans één tot twee weken in beslag, na het eerste werfbezoek en de opmeting.",
  },
];
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Tuinontwerp Hasselt", path: "/tuinontwerp-hasselt/" },
];
---
<Layout
  title="Tuinontwerp Hasselt | Mani Verdi"
  description={service.seoDescription}
  path="/tuinontwerp-hasselt/"
  image={service.image}
  heroImage={service.image}
  breadcrumbs={breadcrumbs}
  jsonLd={[faqSchema(faqItems)]}
>
  <Header />
  <main id="top">
    <Hero
      eyebrow="Dienst · Hasselt"
      title="Tuinontwerp Hasselt"
      lede={service.heroLede}
      bgImage={service.image}
      bgAlt={service.imageAlt}
      primaryLabel="Gratis werfbezoek aanvragen"
      primaryHref="/contact/"
      compact
    />
    <Breadcrumbs items={breadcrumbs} />
    <section class="page-content">
      <div class="wrap">
        <h2>Tuinontwerp in Hasselt op maat van uw perceel</h2>
        <p>
          Tuinontwerp in Hasselt begint bij Mani Verdi niet met een kant-en-klaar model, maar met een bezoek ter
          plaatse. Grondsoort, bezonning, de vorm van het perceel en hoe uw gezin de tuin gebruikt, bepalen samen
          welk ontwerp werkt. Een tuinplan dat mooi oogt op papier maar niet past bij een natte, schaduwrijke hoek
          in Kermt of een zonnig, winderig perceel in Wimmertingen, houdt geen stand.
        </p>
        <p>
          Omdat hetzelfde team dat het ontwerp tekent ook de <a href="/tuinaanleg-hasselt/">tuinaanleg</a>
          uitvoert, blijft een tuinplan realistisch: geen elementen die op papier goed ogen maar in de praktijk
          niet uitvoerbaar of betaalbaar zijn.
        </p>

        <h2>Wat een tuinontwerp bij Mani Verdi omvat</h2>
        <p>
          Een tuinontwerp start met een opmeting en een gesprek over budget, onderhoudsvoorkeur en gewenste sfeer.
          Daaruit volgt een plan met indeling, materiaalkeuze voor paden en terras, beplanting per zone en, waar
          nodig, verlichting. U krijgt een duidelijk beeld van het eindresultaat voor er één spade de grond in gaat.
        </p>
        <h2>Van ontwerp naar aanleg, zonder wisseling van aannemer</h2>
        <p>
          Veel tuinprojecten in Hasselt lopen vast tussen ontwerper en uitvoerder, wanneer een tekenaar iets voorstelt
          dat de aannemer nadien anders aanpakt. Bij Mani Verdi valt dat weg: hetzelfde aanspreekpunt begeleidt het
          project van eerste schets tot de laatste plant, en later ook bij het <a href="/tuinonderhoud-hasselt/">tuinonderhoud</a>.
        </p>
      </div>
    </section>
    <section class="page-content" style="padding-top:0">
      <div class="wrap" style="max-width:1180px">
        <h2>Voorbeelden van tuinontwerp</h2>
        <div class="photo-grid">
          <img src="/images/ontwerp-render-tuin.jpg" width="1920" height="1080" alt="3D-ontwerp van een tuin met gazon, haag en zithoek" loading="lazy" />
          <img src="/images/ontwerp-render-lounge.jpg" width="1920" height="1080" alt="3D-ontwerp van een tuin met loungehoek onder pergola" loading="lazy" />
          <img src="/images/ontwerp-render-tuinmeubel.jpg" width="1920" height="1080" alt="3D-ontwerp van een tuin met ligbedden en parasol" loading="lazy" />
          <img src="/images/ontwerp-render-olijfboom.jpg" width="1920" height="1080" alt="3D-ontwerp van een tuin met olijfboom en grindpad" loading="lazy" />
          <img src="/images/ontwerp-render-voorgevel.jpg" width="1920" height="1080" alt="3D-ontwerp van een tuin met pergola en olijfboom" loading="lazy" />
          <img src="/images/tuinaanleg.jpg" width="1200" height="1600" alt="Afgewerkt tuinaanlegproject, uitgevoerd na een tuinontwerp" loading="lazy" />
        </div>
      </div>
    </section>
    <Faq items={faqItems} />
    <RelatedServices exclude="tuinontwerp-hasselt" />
    <Cta />
  </main>
  <Footer />
</Layout>
