---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RelatedServices from "../../components/RelatedServices.astro";
import Faq from "../../components/Faq.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";
import { services } from "../../data/site";
import { faqSchema } from "../../data/schema";

const service = services.find((s) => s.slug === "tuinonderhoud-hasselt")!;
const faqItems = [
  {
    q: "Hoe vaak komt Mani Verdi langs voor tuinonderhoud?",
    a: "Dat hangt af van de tuin en het seizoen. De meeste klanten in Hasselt kiezen voor een vast onderhoudsplan met beurten in het voor- en najaar, aangevuld met tussentijds snoeiwerk waar nodig.",
  },
  {
    q: "Kan Mani Verdi ook onderhoud doen aan een tuin die niet door hen is aangelegd?",
    a: "Ja. Mani Verdi verzorgt tuinonderhoud in Hasselt en omgeving ongeacht wie de tuin oorspronkelijk heeft aangelegd.",
  },
];
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Tuinonderhoud Hasselt", path: "/tuinonderhoud-hasselt/" },
];
---
<Layout
  title="Tuinonderhoud Hasselt | Mani Verdi"
  description={service.seoDescription}
  path="/tuinonderhoud-hasselt/"
  image={service.image}
  breadcrumbs={breadcrumbs}
  jsonLd={[faqSchema(faqItems)]}
>
  <Header />
  <main id="top">
    <Hero
      eyebrow="Dienst · Hasselt"
      title="Tuinonderhoud Hasselt"
      lede={service.heroLede}
      bgImage="/images/project-terras.jpg"
      bgAlt="Verzorgde tuin met terras en hagen, onderhouden door Mani Verdi"
      primaryLabel="Gratis werfbezoek aanvragen"
      primaryHref="/contact/"
      compact
    />
    <Breadcrumbs items={breadcrumbs} />
    <section class="page-content">
      <div class="wrap">
        <h2>Tuinonderhoud in Hasselt het hele jaar door</h2>
        <p>
          Tuinonderhoud in Hasselt betekent voor Mani Verdi meer dan een keer per jaar het gazon maaien. Een tuin
          die zijn tijdloze uitstraling behoudt, vraagt om een onderhoudsritme dat is afgestemd op het seizoen: snoei
          in het najaar en het vroege voorjaar, bemesting op het juiste moment, en tussentijdse controle van hagen
          en borders.
        </p>
        <p>
          Voor tuinen die Mani Verdi zelf heeft <a href="/tuinaanleg-hasselt/">aangelegd</a>, sluit het onderhoud
          naadloos aan: hetzelfde team kent de beplanting, de bodem en de keuzes die bij het ontwerp zijn gemaakt.
        </p>

        <h2>Vast onderhoudsplan of losse beurten</h2>
        <p>
          Sommige klanten kiezen voor een vast onderhoudsplan met een vaste frequentie, anderen voor losse
          onderhoudsbeurten wanneer het nodig is. Bij het gratis werfbezoek bekijkt Mani Verdi samen met u wat het
          beste past bij uw tuin en uw eigen inbreng.
        </p>

        <h2>Snoeiwerk dat rekening houdt met de plant</h2>
        <p>
          Verkeerd of te laat gesnoeide hagen en heesters herstellen zich soms pas na jaren. Mani Verdi snoeit op het
          moment en op de manier die bij elke soort past, zodat hagen en borders in Hasselt en omgeving jaar na jaar
          hun vorm en gezondheid behouden.
        </p>
        <p>
          Na zware wind of storm is extra controle geen overbodige luxe: lees in
          <a href="/blog/stormschade-tuin-hasselt/">stormschade in uw tuin in Hasselt: wat nu?</a> hoe u schade aan
          hagen en beplanting het best aanpakt.
        </p>
      </div>
    </section>
    <section class="page-content" style="padding-top:0">
      <div class="wrap" style="max-width:1180px">
        <h2>Voorbeelden van tuinonderhoud</h2>
        <div class="photo-grid">
          <img src="/images/onderhoud-snoeien.jpg" alt="Snoeiwerk aan hagen tijdens onderhoud" loading="lazy" />
          <img src="/images/onderhoud-hagen-hoeve.jpg" alt="Strak gesnoeide hagen bij een hoeve" loading="lazy" />
          <img src="/images/onderhoud-gevelbeplanting.jpg" alt="Snoeien van gevelbeplanting met een hoogtewerker" loading="lazy" />
          <img src="/images/onderhoud-hulpstuk.jpg" alt="Hydraulische heggenschaar tijdens snoeiwerk" loading="lazy" />
          <img src="/images/onderhoud-wegberm.jpg" alt="Onderhouden haag langs een landelijke weg" loading="lazy" />
          <img src="/images/onderhoud-haagrand.jpg" alt="Strak gesnoeide haag langs een oprit" loading="lazy" />
        </div>
      </div>
    </section>
    <Faq items={faqItems} />
    <RelatedServices exclude="tuinonderhoud-hasselt" />
    <Cta />
  </main>
  <Footer />
</Layout>
