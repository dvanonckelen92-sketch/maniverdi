---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RelatedServices from "../../components/RelatedServices.astro";
import Faq from "../../components/Faq.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";
import { services } from "../../data/site";
import { faqSchema } from "../../data/schema";

const service = services.find((s) => s.slug === "tuinaanleg-limburg")!;
const faqItems = [
  {
    q: "Wat kost tuinaanleg in Limburg?",
    a: "De prijs hangt af van de oppervlakte, het grondwerk en de gekozen materialen voor bestrating en beplanting. Na een gratis werfbezoek ontvangt u van Mani Verdi een offerte op maat, zonder verrassingen achteraf.",
  },
  {
    q: "Legt Mani Verdi ook terrassen aan in Wellen?",
    a: "Ja. In Wellen legde Mani Verdi een terras aan op twee niveaus met beige terrastegels, baksteenmuurtjes en een afwateringsgoot. Wellen ligt in Limburg en valt binnen het werkgebied vanuit Hasselt.",
  },
  {
    q: "Hoe lang duurt de aanleg van een tuin?",
    a: "Een gemiddelde particuliere tuin duurt, afhankelijk van omvang en grondwerk, twee tot vier weken. Bij het werfbezoek geeft Mani Verdi een concrete planning voor uw project.",
  },
];
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Tuinaanleg Limburg", path: "/tuinaanleg-limburg/" },
];
---
<Layout
  title="Tuinaanleg Limburg | Mani Verdi"
  description={service.seoDescription}
  path="/tuinaanleg-limburg/"
  image={service.image}
  heroImage={service.image}
  breadcrumbs={breadcrumbs}
  jsonLd={[faqSchema(faqItems)]}
>
  <Header />
  <main id="top">
    <Hero
      eyebrow="Dienst · Limburg"
      title="Tuinaanleg Limburg"
      lede={service.heroLede}
      bgImage={service.image}
      bgAlt={service.imageAlt}
      primaryLabel="Gratis werfbezoek aanvragen"
      primaryHref="/contact/"
      compact
    />
    <Breadcrumbs items={breadcrumbs} />
    <section class="page-content">
      <div class="wrap">
        <h2>Tuinaanleg in Limburg van grondwerk tot laatste plant</h2>
        <p>
          Tuinaanleg vraagt om meer dan bestrating en planten: de bodem in Limburg varieert van zandgrond in het
          noorden tot zware klei en zandleem in Haspengouw, en dat bepaalt hoe funderingen, drainage en beplanting
          aangepakt worden. Mani Verdi start elk project met een werfbezoek waarbij grondsoort en waterhuishouding
          bekeken worden, voor er een offerte volgt.
        </p>
        <p>
          Voor projecten die eerst grondverzet of afbraak van oude verhardingen vereisen, gebeuren die
          <a href="/grondwerken-limburg/">grondwerken</a> door hetzelfde team, zodat er geen tweede aannemer nodig is
          en de planning in eigen hand blijft.
        </p>

        <h2>Bestrating, beplanting en verlichting</h2>
        <p>
          De aanleg zelf omvat grondwerk en egalisatie, bestrating in klinkers, natuursteen of gietvloer naar keuze,
          beplanting afgestemd op bezonning en onderhoudsniveau, en waar gewenst tuinverlichting. Elk onderdeel wordt
          uitgevoerd met professionele machines, wat het verschil maakt in afwerking en snelheid tegenover
          handmatig werk.
        </p>

        <h2>Na de aanleg: onderhoud dat de investering beschermt</h2>
        <p>
          Een nieuw aangelegde tuin heeft in het eerste jaar extra zorg nodig: aanslaan van planten, bijsturen van
          het gazon en eerste snoeibeurten. Mani Verdi biedt hiervoor <a href="/tuinonderhoud-limburg/">tuinonderhoud</a>
          aan, met hetzelfde team dat de tuin heeft aangelegd en dus elk detail kent.
        </p>
      </div>
    </section>
    <section class="page-content" id="terras-wellen" style="padding-top:0">
      <div class="wrap" style="max-width:1180px">
        <h2>Terras aanleggen in Wellen: twee niveaus tegen een baksteenwoning</h2>
        <p style="max-width:70ch">
          In Wellen legde Mani Verdi een terras aan tegen een woning in oude baksteen. Het terras ligt op twee niveaus
          en is betegeld met beige terrastegels die aansluiten bij de baksteen van de woning. De hoogteverschillen zijn opgevangen met baksteenmuurtjes met
          blauwgrijze afdekplaten, en een trap leidt naar de lager gelegen deur. Langs de rand van het terras ligt een
          afwateringsgoot, zodat regenwater niet tegen de gevel blijft staan.
        </p>
        <p style="max-width:70ch">
          Wilt u ook een terras laten aanleggen in Wellen of elders in Limburg? Plan een
          <a href="/contact/">gratis werfbezoek</a>: dan bekijkt Mani Verdi ter plaatse het niveauverschil, de afwatering
          en de ondergrond, voor er een offerte volgt.
        </p>
        <div class="project-photos">
          <figure>
            <img src="/images/terras-wellen-overzicht.webp" width="1200" height="1600" alt="Terras met beige terrastegels op twee niveaus tegen een baksteenwoning in Wellen" loading="lazy" />
            <figcaption>Het terras op twee niveaus</figcaption>
          </figure>
          <figure>
            <img src="/images/terras-wellen-twee-niveaus.webp" width="1200" height="1600" alt="Nieuw terras in Wellen met afwateringsgoot, baksteenmuurtjes en zicht op de woning" loading="lazy" />
            <figcaption>Zicht vanaf de tuin op beide niveaus</figcaption>
          </figure>
          <figure>
            <img src="/images/terras-wellen-hardsteen.webp" width="1020" height="1360" alt="Terrasgedeelte in Wellen met blauwgrijze afdekplaten op een baksteenmuurtje" loading="lazy" />
            <figcaption>Afdekplaten op het muurtje tussen de niveaus</figcaption>
          </figure>
          <figure>
            <img src="/images/terras-wellen-afwateringsgoot.webp" width="1200" height="1600" alt="Afwateringsgoot langs de rand van een nieuw terras in Wellen" loading="lazy" />
            <figcaption>De afwateringsgoot langs de rand</figcaption>
          </figure>
          <figure>
            <img src="/images/terras-wellen-kelderdeur.webp" width="1200" height="1600" alt="Trap tussen baksteenmuurtjes naar een deur naast een nieuw terras in Wellen" loading="lazy" />
            <figcaption>De trap naar de lager gelegen deur</figcaption>
          </figure>
        </div>
      </div>
    </section>
    <section class="page-content" style="padding-top:0">
      <div class="wrap" style="max-width:1180px">
        <h2>Voorbeelden van tuinaanleg</h2>
        <div class="photo-grid">
          <img src="/images/project-beton.webp" width="800" height="532" alt="Nieuwe betonnen oprit in aanleg" loading="lazy" />
          <img src="/images/project-terras.webp" width="800" height="532" alt="Nieuw aangelegd terras met borders bij een woning" loading="lazy" />
          <img src="/images/project-oprit.webp" width="800" height="532" alt="Grindoprit bij een nieuwbouwwoning" loading="lazy" />
          <img src="/images/project-pad.webp" width="800" height="532" alt="Aangelegd wandelpad met houtsnippers tussen de bomen" loading="lazy" />
          <img src="/images/project-bestrating.webp" width="526" height="512" alt="Nieuwe bestrating in gebakken klinkers bij een woning" loading="lazy" />
          <img src="/images/project-pad-plantvakken.webp" width="526" height="512" alt="Aangelegd pad met plantvakken en grindafwerking" loading="lazy" />
          <img src="/images/project-siergrassen.webp" width="526" height="512" alt="Nieuw aangeplante siergrassen in een border" loading="lazy" />
          <img src="/images/project-terras-border.webp" width="526" height="512" alt="Aangelegd terras met plantenborder bij een woning" loading="lazy" />
          <img src="/images/project-terras-visgraat.webp" width="526" height="512" alt="Terras in visgraatpatroon aangelegd tegen de gevel" loading="lazy" />
          <img src="/images/project-oprit-garage.webp" width="526" height="512" alt="Bestrating in gebakken klinkers naar een garage" loading="lazy" />
          <img src="/images/project-terras-boomspiegel.webp" width="526" height="512" alt="Bestrating met ronde boomspiegel op een terras" loading="lazy" />
          <img src="/images/project-kasseirand.webp" width="526" height="512" alt="Kasseirand als afboording van een oprit" loading="lazy" />
          <img src="/images/project-nieuwe-haag.webp" width="526" height="512" alt="Pas aangeplante haag langs een oprit" loading="lazy" />
          <img src="/images/project-koer.webp" width="526" height="512" alt="Aangelegde koer in gebakken klinkers" loading="lazy" />
          <img src="/images/project-waterplanten.webp" width="526" height="512" alt="Aanplant van waterplanten langs een vijver" loading="lazy" />
          <img src="/images/project-terraspad.webp" width="526" height="512" alt="Grindterras aangelegd tegen een woning" loading="lazy" />
          <img src="/images/project-gazon-park.webp" width="526" height="512" alt="Gemaaid gazon met parkaanleg" loading="lazy" />
          <img src="/images/werkfoto-gazonrand.webp" width="526" height="512" alt="Medewerker van Mani Verdi legt een gazonrand aan" loading="lazy" />
          <img src="/images/werkfoto-graszoden.webp" width="526" height="512" alt="Graszoden klaar om gelegd te worden" loading="lazy" />
          <img src="/images/project-van-werf.webp" width="526" height="512" alt="Bedrijfswagen van Mani Verdi op een werf" loading="lazy" />
          <img src="/images/project-van-plantvak.webp" width="526" height="512" alt="Bedrijfswagen van Mani Verdi bij een nieuw plantvak" loading="lazy" />
        </div>
      </div>
    </section>
    <Faq items={faqItems} />
    <RelatedServices exclude="tuinaanleg-limburg" />
    <Cta />
  </main>
  <Footer />
</Layout>
