---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RelatedServices from "../../components/RelatedServices.astro";
import Faq from "../../components/Faq.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";
import { services } from "../../data/site";
import { faqSchema } from "../../data/schema";

const service = services.find((s) => s.slug === "rioleringswerken-hasselt")!;
const faqItems = [
  {
    q: "Voert Mani Verdi ook de afkoppeling van hemelwater uit?",
    a: "Ja, de afkoppeling van hemelwater en regenwater van het rioolstelsel is een van de rioleringswerken die Mani Verdi in Hasselt en omgeving uitvoert, vaak in combinatie met een tuinrenovatie.",
  },
  {
    q: "Moet ik apart een rioleringsbedrijf inschakelen bij een tuinrenovatie?",
    a: "Niet noodzakelijk. Wanneer rioleringswerken samenvallen met grondwerk of tuinaanleg, voert Mani Verdi ze uit binnen hetzelfde project, zodat de werf maar één keer open hoeft.",
  },
];
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Rioleringswerken Hasselt", path: "/rioleringswerken-hasselt/" },
];
---
<Layout
  title="Rioleringswerken Hasselt | Mani Verdi"
  description={service.seoDescription}
  path="/rioleringswerken-hasselt/"
  image={service.image}
  breadcrumbs={breadcrumbs}
  jsonLd={[faqSchema(faqItems)]}
>
  <Header />
  <main id="top">
    <Hero
      eyebrow="Dienst · Hasselt"
      title="Rioleringswerken Hasselt"
      lede={service.heroLede}
      bgImage="/images/project-oprit.jpg"
      bgAlt="Grondwerken en aansluitingen bij een woning in Hasselt"
      primaryLabel="Gratis werfbezoek aanvragen"
      primaryHref="/contact/"
      compact
    />
    <Breadcrumbs items={breadcrumbs} />
    <section class="page-content">
      <div class="wrap">
        <h2>Rioleringswerken in Hasselt bij tuinaanleg en renovatie</h2>
        <p>
          Rioleringswerken in Hasselt komen bij Mani Verdi meestal aan bod als onderdeel van een groter project:
          een nieuwe aansluiting bij tuinaanleg, herstel van een verzakte leiding, of een afkoppeling van hemelwater
          bij een renovatie. Omdat dit werk samenvalt met het grondwerk, wordt het uitgevoerd door hetzelfde team dat
          ook de <a href="/grondwerken-hasselt/">grondwerken</a> doet.
        </p>

        <h2>Aansluiting, afkoppeling en herstel</h2>
        <p>
          Naargelang de situatie gaat het om een nieuwe rioolaansluiting, het afkoppelen van hemelwater naar een
          infiltratievoorziening, of het herstellen van een beschadigde of verzakte leiding. Mani Verdi bekijkt bij
          het werfbezoek wat de bestaande situatie toelaat en welke ingreep nodig is.
        </p>

        <h2>Eén werf, geen tweede aannemer</h2>
        <p>
          Wanneer rioleringswerken los worden aanbesteed van de tuinaanleg, ligt de werf vaak twee keer open en
          moeten twee aannemers hun planning op elkaar afstemmen. Bij Mani Verdi gebeurt dit binnen één traject, van
          grondwerk tot de uiteindelijke <a href="/tuinaanleg-hasselt/">tuinaanleg</a>.
        </p>
      </div>
    </section>
    <section class="page-content" style="padding-top:0">
      <div class="wrap" style="max-width:1180px">
        <h2>Voorbeelden van rioleringswerken</h2>
        <div class="photo-grid">
          <img src="/images/riolering.jpg" alt="Graafwerk voor een rioleringsleiding in een tuin" loading="lazy" />
          <img src="/images/riolering-fundering.jpg" alt="Rioleringsbuizen bij een funderingswerf" loading="lazy" />
          <img src="/images/riolering-muur.jpg" alt="Rioleringswerken tegen een bestaande muur" loading="lazy" />
          <img src="/images/riolering-vloer.jpg" alt="Opgebroken vloer voor rioleringswerken" loading="lazy" />
        </div>
      </div>
    </section>
    <Faq items={faqItems} />
    <RelatedServices exclude="rioleringswerken-hasselt" />
    <Cta />
  </main>
  <Footer />
</Layout>
