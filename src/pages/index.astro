---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import About from "../components/About.astro";
import Work from "../components/Work.astro";
import Area from "../components/Area.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import { faqs } from "../data/site";
import { faqSchema } from "../data/schema";
---
<Layout
  title="Tuinaannemer Limburg | Mani Verdi"
  description="Mani Verdi is tuinaannemer in heel Limburg: tuinontwerp, tuinaanleg en tuinonderhoud, met Hasselt, Heusden-Zolder, Genk en Bilzen als vaste werkgebieden."
  path="/"
  heroImage="/images/hero.webp"
  jsonLd={[faqSchema(faqs)]}
>
  <Header />
  <main id="top">
    <Hero
      eyebrow="Tuinaannemer · heel Limburg"
      title="Tuinaannemer in Limburg voor tuinen om jarenlang van te"
      emphasis="genieten"
      lede="Mani Verdi ontwerpt, legt aan en onderhoudt tuinen in heel Limburg, vanuit Hasselt, en de ploeg die de eerste schets maakt, komt later ook snoeien."
      bgImage="/images/hero.webp"
      bgAlt="Weelderig aangelegde tuin met slingerend gazonpad van Mani Verdi in Limburg"
      secondaryLabel="Bekijk onze diensten"
      secondaryHref="#diensten"
    />
    <Services />
    <About />
    <Work />
    <Area />
    <Faq items={faqs} />
    <Cta />
  </main>
  <Footer />
</Layout>
